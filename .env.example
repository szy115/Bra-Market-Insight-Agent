# Optional official Reddit OAuth credentials.
# Agent Reach/OpenCLI is the preferred live Reddit path. OAuth/RSS are secondary modes.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InsightAgentRedditDemo/0.1 by yourname

# Optional Agent Reach local data collection.
# Install with: .\scripts\install-agent-reach.ps1
# Then open Settings -> Agent Reach -> Reconnect OpenCLI extension.
AGENT_REACH_ENABLED=1
AGENT_REACH_BACKEND=opencli
AGENT_REACH_TIMEOUT=90
AGENT_REACH_DETAIL_LIMIT=20
AGENT_REACH_COMMENTS_PER_POST=20
AGENT_REACH_VENV=
AGENT_REACH_BIN_DIR=

# Research collection defaults.
# agent_reach fails closed when OpenCLI/rdt is not ready; switch to sample for a no-network demo.
INSIGHT_RESEARCH_MODE=agent_reach
INSIGHT_RESEARCH_TIME_RANGE=year
INSIGHT_RESEARCH_POST_LIMIT=100
INSIGHT_LLM_EVIDENCE_POSTS=50
INSIGHT_LLM_COMMENT_SAMPLES_PER_POST=10

# Optional Amazon collection through OpenCLI.
AMAZON_OPENCLI_ENABLED=1
AMAZON_OPENCLI_TIMEOUT=90
# Per expanded keyword; total raw shelf requests are product limit × keyword limit.
AMAZON_PRODUCT_LIMIT=20
AMAZON_KEYWORD_LIMIT=8
AMAZON_DETAIL_LIMIT=5
AMAZON_DISCUSSION_LIMIT=5
AMAZON_REVIEWS_PER_PRODUCT=5
AMAZON_LLM_PRODUCT_LIMIT=25
AMAZON_LLM_REVIEW_SAMPLES_PER_PRODUCT=5

# Optional Web Search for automatic media/ranking article discovery.
# Default provider uses local Agent Reach / Exa Search. Alternatives: brave, tavily, google_cse.
INSIGHT_WEB_SEARCH_PROVIDER=agent_reach
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional Sif MCP integration.
# Endpoint docs: https://mcp.sif.com/#tools
SIF_MCP_URL=https://mcp.sif.com/mcp
SIF_MCP_SCHEMA_URL=https://mcp.sif.com/mcp-api/tool-schema.json
SIF_MCP_TOKEN=
# Default exposes a curated market/ASIN subset. Use "*" to expose all Sif MCP tools.
SIF_MCP_TOOLS=market_get_keyword_demand,market_get_keyword_history,market_get_keyword_root_trend,market_get_keyword_competition,market_get_asin_keyword_signals,ops_get_asin_sales_list,ops_get_asin_sales_trend

# Optional SellerSprite MCP integration.
# MCP config type: streamableHttp
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
SELLERSPRITE_MCP_SECRET_KEY=
# Default exposes all tools returned by SellerSprite tools/list. Set a comma-separated list to curate.
SELLERSPRITE_MCP_TOOLS=*

# Optional FastMoss MCP integration for TikTok Shop market insight.
# Official Streamable HTTP endpoint; the adapter appends api_key as a query parameter.
FASTMOSS_MCP_URL=https://mcp.fastmoss.com/mcp
FASTMOSS_MCP_API_KEY=
# Default exposes the curated TikTok Shop insight toolset. Use "*" to expose all FastMoss MCP tools.
FASTMOSS_MCP_TOOLS=

# Shared FastMoss/SellerSprite/Sif result cache. Same tool + same normalized parameters reuse data for 7 days.
MCP_RESULT_CACHE_TTL_SECONDS=604800
# Leave empty to use .cache/mcp-results under the project directory.
MCP_RESULT_CACHE_DIR=

# Local Flint chart MCP. The default CLI is chart-runtime/node_modules/flint-chart-mcp/dist/cli.js.
FLINT_CHART_NODE_COMMAND=node
FLINT_CHART_MCP_CLI=
FLINT_CHART_TIMEOUT_SECONDS=20
FLINT_CHART_TOTAL_TIMEOUT_SECONDS=120

# LLM analysis is requested by default. Without an API key, reports still run and show an LLM warning.
INSIGHT_LLM_PROVIDER=deepseek
INSIGHT_LLM_MODEL=deepseek-v4-pro
INSIGHT_LLM_TEMPERATURE=0.2
INSIGHT_LLM_TIMEOUT=90
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Local server settings.
PORT=8000
INSIGHT_AGENT_HOME=
