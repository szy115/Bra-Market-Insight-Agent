# Optional official Reddit OAuth credentials.
# Without these, the demo tries Reddit RSS and then falls back to sample data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InsightAgentRedditDemo/0.1 by yourname

# Optional Agent Reach local data collection.
# Install with: .\scripts\install-agent-reach.ps1
AGENT_REACH_ENABLED=1
AGENT_REACH_BACKEND=opencli
AGENT_REACH_TIMEOUT=90
AGENT_REACH_DETAIL_LIMIT=8
AGENT_REACH_COMMENTS_PER_POST=20
AGENT_REACH_VENV=
AGENT_REACH_BIN_DIR=

# Research collection defaults.
INSIGHT_RESEARCH_MODE=auto
INSIGHT_RESEARCH_TIME_RANGE=year
INSIGHT_RESEARCH_POST_LIMIT=50
INSIGHT_LLM_EVIDENCE_POSTS=12
INSIGHT_LLM_COMMENT_SAMPLES_PER_POST=5

# Optional LLM analysis.
INSIGHT_LLM_PROVIDER=openai
INSIGHT_LLM_MODEL=gpt-5.5
INSIGHT_LLM_TEMPERATURE=0.2
INSIGHT_LLM_TIMEOUT=90
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Local server settings.
PORT=8000
INSIGHT_AGENT_HOME=
