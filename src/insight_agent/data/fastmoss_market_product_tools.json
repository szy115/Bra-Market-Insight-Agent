      "properties": {
        "analysis_type": {
          "description": "Analysis type parameter.",
          "enum": [
            "basic_metrics",
            "sales_trends",
            "price_distribution"
          ],
          "type": "string"
        },
        "filter": {
          "description": "Filter parameters.",
          "properties": {
            "category_id": {
              "description": "Product category ID. Only level-1 category IDs are supported; level-2 or level-3 category IDs are not supported. Default -100 means all categories.",
              "type": "integer"
            },
            "date_type": {
              "description": "Ranking period: day, week, or month; MCN agency rankings support only week/month.",
              "type": "string"
            },
            "date_value": {
              "description": "Completed period only: yesterday YYYY-MM-DD, last week YYYY-ww or YYYY-Www, last month YYYY-MM; do not use the current period.",
              "type": "string"
            },
            "region": {
              "description": "Country or region code, e.g. US, UK, ID.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "lang": {
          "description": "Language. Default EN_US, optional ZH_CN.",
          "type": "string"
        }
      },
      "required": [
        "filter",
        "analysis_type"
      ],
      "type": "object"
    }
  },
