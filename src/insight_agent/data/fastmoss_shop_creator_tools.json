            },
            "time_range_days": {
              "default": 28,
              "description": "Sales analysis period in days. Allowed values: 7, 28, 90. Default 28.",
              "enum": [
                7,
                28,
                90
              ],
              "type": "integer"
            }
          },
          "required": [
            "seller_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "filter"
      ],
      "type": "object"
    }
  },
